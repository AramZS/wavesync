# WaveSync build-time configuration (Vue CLI VUE_APP_* variables).
# These are injected into the client bundle at build time. No client secret
# is used anywhere — WaveSync uses the Authorization Code with PKCE flow.
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env

# Your Spotify application's public Client ID (from the Spotify Developer Dashboard).
VUE_APP_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# OAuth redirect URI. For local development use the value below.
# For the deployed site, set this to https://<your-netlify-domain>/callback.
VUE_APP_REDIRECT_URI=http://localhost:8080/callback
